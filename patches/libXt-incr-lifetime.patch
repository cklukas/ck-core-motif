@@ -365,0 +366,28 @@
+static Select
+LookupCtx(Display *dpy, Atom selection)
+{
+    Select ctx = NULL;
+
+    LOCK_PROCESS;
+    if (selectContext != 0 &&
+        XFindContext(dpy, (Window) selection, selectContext,
+                     (XPointer *) &ctx))
+        ctx = NULL;
+    UNLOCK_PROCESS;
+    return ctx;
+}
+
+static void
+FreeContext(Select ctx)
+{
+    XPointer current = NULL;
+
+    LOCK_PROCESS;
+    if (XFindContext(ctx->dpy, (Window) ctx->selection, selectContext,
+                     &current) == 0 && (Select) current == ctx)
+        (void) XDeleteContext(ctx->dpy, (Window) ctx->selection,
+                              selectContext);
+    UNLOCK_PROCESS;
+    XtFree((char *) ctx);
+}
+
